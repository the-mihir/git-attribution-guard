# Shell scripts must keep LF endings on every platform (Git Bash included).
* text=auto eol=lf
*.sh text eol=lf
scripts/attribution text eol=lf
scripts/hooks/* text eol=lf
install.sh text eol=lf

# Not shipped in release archives (git archive)
/.github export-ignore
/tests export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/.editorconfig export-ignore
/Makefile export-ignore
